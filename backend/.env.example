# Database (optional). Defaults to a local SQLite file if unset — see
# app/database.py. Set this to a Postgres URL (e.g. Neon/Supabase) for
# deployments where the filesystem isn't persistent.
# DATABASE_URL=

# --- IOC Lookup feature (backend/app/ioc/) ---
# All keys below are optional. Any provider left unconfigured is skipped
# gracefully (reported as "not_configured" in the lookup result) rather than
# breaking the feature — the internal ThreatPulse correlation requires no
# key and always runs.

# https://www.abuseipdb.com/account/api - free tier, IP reputation
ABUSEIPDB_API_KEY=

# https://www.virustotal.com/gui/my-apikey - free tier, IP/domain/URL/hash
VIRUSTOTAL_API_KEY=

# https://otx.alienvault.com/api - free, IP/domain/URL/hash threat pulses
OTX_API_KEY=

# https://auth.abuse.ch/ - free "Auth-Key" account, required since abuse.ch
# made authentication mandatory on URLhaus/MalwareBazaar/ThreatFox (Jun 2025)
URLHAUS_AUTH_KEY=

# Minutes a lookup result stays cached before a repeat lookup re-queries
# providers instead of serving the cached report. Default: 60.
# IOC_CACHE_TTL_MINUTES=60
